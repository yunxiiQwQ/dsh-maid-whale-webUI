{
  "name": "@dsh-external/dsh-client-ui-skin-maid-whale-webui",
  "description": "Cloud-paper DeepSeek skin for the DSH web GUI with the deepseek-drool character as a quiet page-edge mascot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./skin.json": "./skin.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "art:embed": "node scripts/embed-background.mjs && node scripts/embed-ornaments.mjs && node scripts/embed-frames.mjs",
    "art:embed:background": "node scripts/embed-background.mjs",
    "art:embed:ornaments": "node scripts/embed-ornaments.mjs",
    "art:embed:frames": "node scripts/embed-frames.mjs",
    "art:embed:check": "node scripts/check-embedded-art.mjs",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.vitest.json --noEmit",
    "test": "vitest run",
    "build:helper:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-helper.ps1",
    "test:helper:packaged": "node scripts/test-packaged-helper.mjs",
    "test:python": "py -3 -m unittest discover -s runtime/tests -t ."
  },
  "license": "BSD-3-Clause",
  "packageManager": "pnpm@11.21.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "18.3.7",
    "jsdom": "29.1.1",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skin.json",
    "preview",
    "README.md",
    "README.en.md",
    "LICENSE",
    "NOTICE",
    "runtime/",
    "assets/pet/",
    "assets/pet-manifest.json",
    "scripts/build-helper.ps1",
    "scripts/test-packaged-helper.mjs",
    "requirements.txt"
  ],
  "cpu": [
    "x64"
  ],
  "engines": {
    "node": ">=22.19"
  }
}
